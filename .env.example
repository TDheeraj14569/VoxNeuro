# ==============================================================================
# VoxNeuro Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit active .env credentials or production secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
VOXNEURO_ENV=production

# Application Server Port
VOXNEURO_PORT=8501

# Database Configuration (SQLite path; defaults to data/voxneuro.db)
VOXNEURO_DB_PATH=data/voxneuro.db

# Authentication & Cryptographic Signing Key (HMAC / Session token secret)
# Minimum 32-byte high-entropy secret string
VOXNEURO_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production

# Privacy-Preserving HMAC Key for Participant Withdrawal Tombstones
# Required by src/voxneuro/study/withdrawal.py to generate un-linkable cryptographic deletion receipts.
VOXNEURO_HMAC_KEY=change_this_to_a_secure_random_64_character_hex_string_for_tombstones

# Clinical Safety Gate - Microphone Inference Policy
# STRICT SAFETY NOTICE: Keep set to false unless external clinical validation has
# been certified and approved by regulatory authorities for the specific transducer domain.
VOXNEURO_ALLOW_MIC_INFERENCE=false

# Audit & Logging Configuration
VOXNEURO_LOG_LEVEL=INFO

# Data Retention Policy (days; 0 = indefinite for consented research records)
VOXNEURO_RECORDING_RETENTION_DAYS=0
